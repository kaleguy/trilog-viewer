{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TriLog Viewer",
  "version": "1.1.2",
  "identifier": "app.trilog.viewer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TriLog Viewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Joseph Orr (722BU6KN95)",
      "providerShortName": "722BU6KN95",
      "minimumSystemVersion": "11.0"
    }
  }
}
